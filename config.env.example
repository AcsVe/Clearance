# انسخ هذا الملف باسم config.env بجانب البرنامج، واملأ القيم على الخادم نفسه.
# لا تلصق هذه القيم في أي محادثة أو بريد.

# مفتاح سري طويل وعشوائي (مثلًا: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=

# العنوان العام للنظام — إلزامي، تُبنى منه كل الروابط المرسلة بالبريد
BASE_URL=https://clearance.example.duckdns.org

# PostgreSQL (psycopg 3)
DATABASE_URL=postgresql://clearance_app:CHANGE_ME@localhost:5432/clearance

# مجلد المرفقات (شعارات، صور العهد الممسوحة)
UPLOAD_DIR=C:\Clearance\uploads

# Microsoft Graph — نفس إعدادات نظام الحجز
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=

# التذكيرات المجدولة (1 = إيقاف)
DISABLE_REMINDERS=0
# كل كم يومًا يتكرر تذكير العهدة المتأخرة
OVERDUE_REMINDER_DAYS=7

# إشعارات الهاتف (Web Push) — اختياري. أنشئ المفاتيح مرة واحدة بالأمر:
#   flask --app app:create_app generate-vapid
# والصق الناتج هنا على الخادم فقط.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:it@example.com

# خلف Caddy على نفس الجهاز اتركها 1
TRUST_PROXY=1

TIMEZONE=Asia/Amman
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
